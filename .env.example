# Required: a fine-grained GitHub token with no repository permissions ("Public repositories (read-only)").
GITHUB_TOKEN=

# Optional: enables GET /insights/narrative. Without it that endpoint returns 503.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high

# Optional tuning (defaults shown)
# PORT=3000
# HOST=127.0.0.1
# DATABASE_PATH=./data/repo-pulse.db
# SYNC_TTL_MINUTES=15
# SYNC_MAX_PAGES=40
# MAX_PERIOD_DAYS=180
# ALLOWED_REPOS=fastify/fastify,nodejs/undici
# RATE_LIMIT_PER_MINUTE=60
# NARRATIVE_RATE_LIMIT_PER_MINUTE=6
# LOG_LEVEL=info
