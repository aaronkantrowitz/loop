{
  "name": "repo-pulse",
  "version": "0.1.0",
  "description": "GitHub collaboration insights with an LLM narrative that cites its evidence",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronkantrowitz/loop.git"
  },
  "author": "aaronkantrowitz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aaronkantrowitz/loop/issues"
  },
  "homepage": "https://github.com/aaronkantrowitz/loop#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/etag": "^6.2.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
